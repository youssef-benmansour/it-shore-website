DirectoryIndex index.html
Options -Indexes

# Le site est 100 % statique : aucun script serveur ne doit pouvoir s'exécuter
<FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|suspected)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # HTTPS + domaine sans www
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.*)$ https://it-shore.com/$1 [R=301,L]
    # Anciennes pages WordPress / pages de spam : renvoyer « disparu » (410)
    RewriteCond %{QUERY_STRING} (^|&)(sitemap[0-9a-z]*\.xml|p=|page_id=) [NC]
    RewriteRule ^ - [G,L]
    RewriteRule ^(wp-admin|wp-content|wp-includes|4c68c)(/|$) - [G,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
